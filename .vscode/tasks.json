{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "luacheck",
            "type": "shell",
            "command": "/usr/local/bin/luacheck . | tee report.log",
            "problemMatcher": {
                "owner": "lua",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^\\s*(.*):(\\d+):(\\d+):\\s*(.*)\\s*$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "l10n",
            "type": "shell",
            "command": "python3 ./scripts/l10n_strings.py --parser",
            "problemMatcher": {
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(Info|Warning):(.*\\.lua):(.*)$",
                    "severity": 1,
                    "file": 2,
                    "message": 3
                }
            }
        },
        {
            "label": "release",
            "type": "shell",
            "command": "./scripts/release.sh -d -o -u -m .pkgmeta",
            "problemMatcher": []
        },
        {
            "label": "deploy",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "mkdir -p /wow/${input:WOW_TARGET}/Interface/AddOns/ && cp -r .release/* /wow/${input:WOW_TARGET}/Interface/AddOns/",
            ],
            "problemMatcher": []
        },
        {
            "label": "debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "grep --include=\"*.lua\" -rl \"do-not-package\" | xargs -I {} cp {} /wow/${input:WOW_TARGET}/Interface/AddOns/{}"
            ],
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "find",
            "args": [
                "/wow/*/Interface/AddOns/",
                "-maxdepth", "1",
                "-type", "d",
                "-name", "\"ClassicLootManager*\"",
                "-exec", "rm", "-rf", "{}", "+",
            ],
            "problemMatcher": []
        },
        {
            "label": "clean deploy debug",
            "dependsOn": [
                "clean",
                "deploy",
                "debug"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "copy file",
            "type": "shell",
            "command": "cp ${relativeFile} /wow/${input:WOW_TARGET}/Interface/AddOns/${relativeFile}",
            "problemMatcher": []
        },
    ],
    "inputs": [
        {
            "id": "WOW_TARGET",
            "description": "WoW target",
            "default": "_retail_",
            "type": "pickString",
            "options": [
                "_retail_",
                "_ptr_",
                "_classic_ptr_",
                "_classic_beta_",
            ]
        }
    ]
}